{
  "name": "linux-nexus",
  "version": "0.1.0",
  "private": true,
  "description": "Linux Nexus, a Windows desktop client for browsing files on Ubuntu servers over SSH/SFTP",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "dist:win": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.555.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.7"
  },
  "build": {
    "appId": "com.local.linuxnexus",
    "productName": "Linux Nexus",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/app.ico",
        "to": "app.ico"
      }
    ],
    "asar": true,
    "win": {
      "icon": "resources/app.ico",
      "signExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
